#!/usr/bin/env bun
import { copyFileSync, existsSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";

const emit = (event: Record<string, unknown>) => process.stdout.write(`${JSON.stringify(event)}\n`);
const turn = (usd: number, text = "working") =>
  emit({
    type: "message_end",
    message: { role: "assistant", stopReason: "stop", usage: { cost: { total: usd } }, content: [{ type: "text", text }] },
  });

const steers: string[] = [];
let aborted = false;
let prompt = "";

const directive = (name: string) => prompt.match(new RegExp(`^fake-${name}: (.*)$`, "m"))?.[1]?.trim();

const tryRead = (path: string) => {
  emit({ type: "tool_execution_start", toolName: "read" });
  try {
    readFileSync(path, "utf8");
    return "read-ok";
  } catch (error) {
    return `read-blocked ${(error as NodeJS.ErrnoException).code}`;
  }
};

const work = async () => {
  const fixFrom = directive("fix");
  const fixTo = directive("to");
  const peek = directive("peek");
  const waitMs = Number(directive("wait") ?? "0");
  const burn = Number(directive("burn") ?? "0");

  if (peek) writeFileSync("peek.txt", tryRead(peek));
  const deadline = Date.now() + waitMs;
  while (Date.now() < deadline && !aborted) {
    if (burn > 0) turn(burn);
    await Bun.sleep(100);
  }
  if (aborted) return;
  if (steers.length > 0) writeFileSync("steer.txt", steers.join("\n"));
  const onlyRound = directive("only-round");
  const round = process.cwd().includes("-r2-") ? "2" : "1";
  const needSteer = directive("needs-steer") === "yes";
  const allowed = (!onlyRound || onlyRound === round) && (!needSteer || steers.length > 0);
  if (allowed && fixFrom && fixTo && existsSync(fixFrom)) {
    emit({ type: "tool_execution_start", toolName: "write" });
    try {
      copyFileSync(fixFrom, join(process.cwd(), fixTo));
    } catch {}
  }
  turn(0.01, "done");
  emit({ type: "agent_end", messages: [], willRetry: false });
  emit({ type: "agent_settled", aborted: false });
};

const decoder = new TextDecoder();
let buffer = "";
for await (const chunk of Bun.stdin.stream()) {
  buffer += decoder.decode(chunk, { stream: true });
  let newline = buffer.indexOf("\n");
  while (newline >= 0) {
    const record = JSON.parse(buffer.slice(0, newline));
    buffer = buffer.slice(newline + 1);
    if (record.type === "prompt") {
      prompt = String(record.message);
      emit({ id: record.id, type: "response", command: "prompt", success: true, data: { disposition: "started" } });
      emit({ type: "agent_start" });
      void work();
    }
    if (record.type === "steer") {
      steers.push(String(record.message));
      emit({ type: "response", command: "steer", success: true, data: { disposition: "queued" } });
    }
    if (record.type === "abort") {
      aborted = true;
      emit({ type: "response", command: "abort", success: true });
      emit({ type: "agent_settled", aborted: true });
    }
    newline = buffer.indexOf("\n");
  }
}
