#!/usr/bin/env bun
import { copyFileSync } from "node:fs";
import { join } from "node:path";

const fixDir = process.env.FAKE_FIX_DIR ?? "";
if ((process.env.ASSAY_WRITABLE ?? "").includes("cart.ts")) copyFileSync(join(fixDir, "src/cart.ts"), "src/cart.ts");
console.log(JSON.stringify({ type: "tool_execution_start", toolName: "write" }));
console.log(
  JSON.stringify({
    type: "message_end",
    message: { role: "assistant", stopReason: "stop", usage: { cost: { total: 0.01 } }, content: [{ type: "text", text: "done" }] },
  }),
);
