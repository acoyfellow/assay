{
  "compilerOptions": {
    "target": "es2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "composite": true,
    "lib": ["es2022"],
    "types": []
  },
  "include": ["src", "test"]
}
