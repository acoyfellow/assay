{
	"compilerOptions": {
		"target": "es2022",
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"emitDeclarationOnly": true,
		"outDir": "dist",
		"strict": true,
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"composite": true,
		"lib": ["es2022"],
		"types": ["bun"]
	},
	"include": ["src", "test"],
	"references": []
}
