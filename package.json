{
  "name": "assay",
  "private": true,
  "type": "module",
  "description": "Spin up a fleet of coding agents. Each gets its own copy of your repo. A test it never saw checks the work.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acoyfellow/assay.git"
  },
  "workspaces": ["packages/*"],
  "scripts": {
    "check": "tsc -b && biome check .",
    "test": "bun run --filter '*' test",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "typescript": "^7.0.2"
  }
}
